<!-- Tweet Edit Page -->
<div class="sticky top-0 z-10 bg-white dark:bg-black/80 backdrop-blur-lg border-b border-gray-200 dark:border-gray-800/50">
  <div class="flex items-center gap-6 px-4 py-3">
    <a href="<%= tweet_path(@tweet) %>" class="p-2 -ml-2 rounded-full hover:bg-black/10 dark:hover:bg-black/10 dark:bg-white/10 transition-colors">
      <svg class="w-5 h-5 text-gray-900 dark:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    </a>
    <h1 class="text-xl font-extrabold text-gray-900 dark:text-white">Tweet'i Düzenle</h1>
  </div>
</div>

<div class="px-4 py-4">
  <div class="flex gap-3">
    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-violet-500 to-fuchsia-500 flex items-center justify-center text-gray-900 dark:text-white font-bold text-sm flex-shrink-0">
      <%= current_user.username[0..1].upcase %>
    </div>
    <div class="flex-1">
      <%= form_with(model: @tweet, class: "w-full") do |f| %>
        <%= f.text_area :content,
          rows: 4,
          maxlength: 280,
          class: "w-full bg-transparent text-xl text-gray-900 dark:text-white placeholder-gray-600 border-none resize-none focus:outline-none focus:ring-0 py-2" %>

        <% if @tweet.errors.any? %>
          <div class="mt-2 text-red-400 text-sm">
            <% @tweet.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="flex justify-end mt-4 pt-3 border-t border-gray-200 dark:border-gray-800/50">
          <%= f.submit "Güncelle",
            class: "bg-gradient-to-r from-sky-500 to-blue-600 text-gray-900 dark:text-white font-bold py-2 px-6 rounded-full hover:from-sky-400 hover:to-blue-500 transition-all duration-300 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
