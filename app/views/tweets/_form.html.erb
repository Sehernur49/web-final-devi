<!-- Tweet Form Partial -->
<div id="tweet_form">
  <%= form_with(model: tweet, url: tweets_path, class: "w-full", data: { controller: "tweet-form" }) do |f| %>
    <div class="relative">
      <%= f.text_area :content,
        placeholder: "Neler oluyor?",
        rows: 3,
        maxlength: 280,
        class: "w-full bg-transparent text-xl text-gray-900 dark:text-white placeholder-gray-600 border-none resize-none focus:outline-none focus:ring-0 py-2",
        data: { tweet_form_target: "content", action: "input->tweet-form#updateCounter" } %>
    </div>

    <% if tweet.errors.any? %>
      <div class="mt-2 text-red-400 text-sm">
        <% tweet.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-200 dark:border-[#2f3336]">
      <!-- Character Counter -->
      <div class="flex items-center gap-3">
        <div class="relative w-8 h-8" data-tweet-form-target="counterContainer">
          <svg class="w-8 h-8 -rotate-90" viewBox="0 0 36 36">
            <circle cx="18" cy="18" r="15.5" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-200 dark:text-gray-800"/>
            <circle cx="18" cy="18" r="15.5" fill="none" stroke="#1d9bf0" stroke-width="2"
              stroke-dasharray="97.5" stroke-dashoffset="97.5" stroke-linecap="round"
              data-tweet-form-target="counterCircle"/>
          </svg>
        </div>
        <span class="text-sm text-gray-500 dark:text-gray-500" data-tweet-form-target="counterText">0/280</span>
      </div>

      <%= f.submit "Tweet at",
        class: "bg-gradient-to-r from-sky-500 to-blue-600 text-white font-bold py-2 px-6 rounded-full hover:from-sky-400 hover:to-blue-500 transition-all duration-300 shadow-lg shadow-sky-500/20 hover:shadow-sky-500/30 disabled:opacity-50 disabled:cursor-not-allowed hover:scale-[1.02] active:scale-[0.98] text-sm",
        data: { tweet_form_target: "submitButton" } %>
    </div>
  <% end %>
</div>
