<!-- Search Results Page -->
<div class="sticky top-0 z-10 bg-white dark:bg-black/80 backdrop-blur-lg border-b border-gray-200 dark:border-gray-800/50">
  <div class="flex items-center gap-6 px-4 py-2">
    <a href="<%= root_path %>" class="p-2 -ml-2 rounded-full hover:bg-black/10 dark:hover:bg-black/10 dark:bg-white/10 transition-colors">
      <svg class="w-5 h-5 text-gray-900 dark:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    </a>
    <div>
      <h1 class="text-xl font-extrabold text-gray-900 dark:text-white">Arama Sonuçları</h1>
      <p class="text-xs text-gray-500 dark:text-gray-500">"<%= @query %>" için sonuçlar</p>
    </div>
  </div>
</div>

<!-- Results Tabs -->
<div class="flex border-b border-gray-200 dark:border-gray-800/50">
  <button class="flex-1 py-3 text-center text-sm font-semibold text-gray-900 dark:text-white relative bg-white/5 transition-colors">
    Tweetler
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-14 h-1 bg-sky-500 rounded-full"></div>
  </button>
</div>

<!-- Users section if any found -->
<% if @users.any? %>
  <div class="border-b-8 border-gray-100 dark:border-gray-900/50">
    <h2 class="px-4 py-3 font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-800/50">Kişiler</h2>
    <% @users.each do |user| %>
      <div class="flex items-center gap-3 px-4 py-3 hover:bg-black/5 dark:hover:bg-black/5 dark:bg-white/5 transition-all duration-200">
        <a href="<%= user_path(user) %>">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-gray-900 dark:text-white font-bold text-sm">
            <%= user.username[0..1].upcase %>
          </div>
        </a>
        <div class="flex-1 min-w-0">
          <a href="<%= user_path(user) %>" class="hover:underline font-bold text-gray-900 dark:text-white text-sm"><%= user.name_display %></a>
          <p class="text-sm text-gray-500">@<%= user.username %></p>
        </div>
        <% if current_user != user %>
          <div id="follow_button_<%= user.id %>">
            <%= render "users/follow_button", user: user %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Tweets results -->
<div id="search_results">
  <% if @tweets.any? %>
    <% @tweets.each do |tweet| %>
      <%= render "tweets/tweet", tweet: tweet %>
    <% end %>
  <% else %>
    <div class="py-20 text-center">
      <h3 class="text-lg font-bold text-gray-600 dark:text-gray-400 mb-2">Sonuç bulunamadı</h3>
      <p class="text-gray-600 text-sm">"<%= @query %>" ile eşleşen bir şey bulamadık.</p>
    </div>
  <% end %>
</div>
