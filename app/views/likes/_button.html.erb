<!-- Like Button Partial -->
<div id="like_button_<%= tweet.id %>">
  <% if (current_user rescue nil)&.liked?(tweet) %>
    <!-- Unlike -->
    <%= button_to tweet_like_path(tweet), method: :delete, class: "flex items-center gap-2 group" do %>
      <div class="p-2 rounded-full group-hover:bg-pink-500/10 transition-colors duration-200">
        <svg class="w-[18px] h-[18px] text-pink-500 animate-like-pop" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>
      <span class="text-[13px] text-pink-500 font-medium group-hover:text-pink-400 transition-colors">
        <%= tweet.likes_count > 0 ? tweet.likes_count : "" %>
      </span>
    <% end %>
  <% else %>
    <!-- Like -->
    <%= button_to tweet_like_path(tweet), method: :post, class: "flex items-center gap-2 group" do %>
      <div class="p-2 rounded-full group-hover:bg-pink-500/10 transition-colors duration-200">
        <svg class="w-[18px] h-[18px] text-gray-500 dark:text-gray-500 group-hover:text-pink-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </div>
      <span class="text-[13px] text-gray-500 dark:text-gray-500 group-hover:text-pink-400 transition-colors">
        <%= tweet.likes_count > 0 ? tweet.likes_count : "" %>
      </span>
    <% end %>
  <% end %>
</div>
