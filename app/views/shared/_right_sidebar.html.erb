<!-- Right Sidebar -->
<aside class="w-[350px] hidden xl:block py-4 px-6 sticky top-0 h-screen overflow-y-auto">
  <!-- Search Bar -->
  <div class="relative mb-6">
    <%= form_with(url: search_tweets_path, method: :get, class: "relative group") do |f| %>
      <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
        <svg class="w-5 h-5 text-gray-500 group-focus-within:text-sky-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <%= f.text_field :q, value: params[:q], placeholder: "Ara...", class: "w-full bg-gray-100 dark:bg-[#202327] border border-transparent dark:border-[#2f3336] rounded-full py-3 pl-12 pr-4 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-sky-500 focus:bg-white dark:focus:bg-black transition-all duration-200" %>
    <% end %>
  </div>

  <!-- Trending / Who to Follow -->
  <div class="bg-gray-50 dark:bg-[#16181c] rounded-2xl border border-gray-200 dark:border-[#2f3336] overflow-hidden mb-6">
    <h2 class="text-xl font-extrabold text-gray-900 dark:text-white px-4 py-3">Kimi Takip Etmeli</h2>
    <div id="suggested-users">
      <% if defined?(@trending_users) && @trending_users.present? %>
        <% @trending_users.each do |user| %>
          <% next if user == current_user %>
          <a href="<%= user_path(user) %>" class="flex items-center gap-3 px-4 py-3 hover:bg-black/5 dark:hover:bg-black/5 dark:bg-white/5 transition-all duration-200">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-gray-900 dark:text-white font-bold text-sm flex-shrink-0">
              <%= user.username[0..1].upcase %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-gray-900 dark:text-white truncate"><%= user.name_display %></p>
              <p class="text-sm text-gray-500 dark:text-gray-500 truncate">@<%= user.username %></p>
            </div>
            <% unless current_user.following?(user) %>
              <span class="text-xs bg-white text-black font-bold px-4 py-1.5 rounded-full hover:bg-gray-200 transition-colors">
                Takip Et
              </span>
            <% end %>
          </a>
        <% end %>
      <% end %>
    </div>
    <a href="<%= users_path %>" class="block px-4 py-3 text-sky-400 hover:bg-black/5 dark:hover:bg-black/5 dark:bg-white/5 transition-all duration-200 text-sm">
      Daha fazla göster
    </a>
  </div>

  <!-- Stats Card -->
  <div class="bg-gray-50 dark:bg-[#16181c] rounded-2xl border border-gray-200 dark:border-[#2f3336] overflow-hidden">
    <h2 class="text-xl font-extrabold text-gray-900 dark:text-white px-4 py-3">İstatistikler</h2>
    <div class="px-4 py-3 space-y-3">
      <div class="flex justify-between items-center">
        <span class="text-gray-600 dark:text-gray-400 text-sm">Tweetlerim</span>
        <span id="tweet_count" class="text-gray-900 dark:text-white font-bold"><%= current_user.tweets_count %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-gray-600 dark:text-gray-400 text-sm">Takipçi</span>
        <span class="text-gray-900 dark:text-white font-bold"><%= current_user.followers_count %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-gray-600 dark:text-gray-400 text-sm">Takip</span>
        <span class="text-gray-900 dark:text-white font-bold"><%= current_user.following_count %></span>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="mt-6 px-4">
    <p class="text-xs text-gray-600 leading-relaxed">
      Çivit &copy; <%= Date.today.year %> · 
      <span class="text-gray-500 dark:text-gray-500">Rails 7 + Hotwire + Tailwind CSS</span>
    </p>
  </div>
</aside>
