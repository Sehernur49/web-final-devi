<!-- Login Page -->
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="text-center mb-10">
      <div class="w-16 h-16 rounded-full bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center mx-auto mb-6 shadow-2xl shadow-sky-500/30">
        <svg class="w-9 h-9 text-gray-900 dark:text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.643 4.937c-.835.37-1.732.62-2.675.733.962-.576 1.7-1.49 2.048-2.578-.9.534-1.897.922-2.958 1.13-.85-.904-2.06-1.47-3.4-1.47-2.572 0-4.658 2.086-4.658 4.66 0 .364.042.718.12 1.06-3.873-.195-7.304-2.05-9.602-4.868-.4.69-.63 1.49-.63 2.342 0 1.616.823 3.043 2.072 3.878-.764-.025-1.482-.234-2.11-.583v.06c0 2.257 1.605 4.14 3.737 4.568-.392.106-.803.162-1.227.162-.3 0-.593-.028-.877-.082.593 1.85 2.313 3.198 4.352 3.234-1.595 1.25-3.604 1.995-5.786 1.995-.376 0-.747-.022-1.112-.065 2.062 1.323 4.51 2.093 7.14 2.093 8.57 0 13.255-7.098 13.255-13.254 0-.2-.005-.402-.014-.602.91-.658 1.7-1.477 2.323-2.41z"/>
        </svg>
      </div>
      <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white mb-2">Çivit'e Giriş Yap</h1>
      <p class="text-gray-500 dark:text-gray-500">Hesabına giriş yaparak devam et</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-900/50 border border-gray-200 dark:border-gray-800/50 rounded-2xl p-8 backdrop-blur-lg shadow-2xl">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <!-- Login (Email or Username) -->
        <div>
          <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">E-posta veya Kullanıcı Adı</label>
          <%= f.text_field :login, autofocus: true, autocomplete: "username",
            class: "w-full bg-white dark:bg-black/50 border border-gray-700 rounded-xl px-4 py-3 text-gray-900 dark:text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all duration-200",
            placeholder: "e-posta veya kullanıcı adı" %>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Şifre</label>
          <%= f.password_field :password, autocomplete: "current-password",
            class: "w-full bg-white dark:bg-black/50 border border-gray-700 rounded-xl px-4 py-3 text-gray-900 dark:text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all duration-200",
            placeholder: "••••••••" %>
        </div>

        <!-- Remember me -->
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-gray-600 bg-white dark:bg-black/50 text-sky-500 focus:ring-sky-500/50" %>
            <span class="text-sm text-gray-600 dark:text-gray-400">Beni hatırla</span>
          </label>
          <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
            <%= link_to "Şifremi unuttum", new_password_path(resource_name), class: "text-sm text-sky-400 hover:text-sky-300 transition-colors" %>
          <% end %>
        </div>

        <!-- Errors -->
        <% if resource.errors.any? %>
          <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4">
            <% resource.errors.full_messages.each do |message| %>
              <p class="text-red-400 text-sm"><%= message %></p>
            <% end %>
          </div>
        <% end %>

        <!-- Submit -->
        <%= f.submit "Giriş Yap",
          class: "w-full bg-gradient-to-r from-sky-500 to-blue-600 text-gray-900 dark:text-white font-bold py-3.5 rounded-full hover:from-sky-400 hover:to-blue-500 transition-all duration-300 shadow-lg shadow-sky-500/25 hover:shadow-sky-500/40 hover:scale-[1.01] active:scale-[0.99] cursor-pointer text-base" %>
      <% end %>
    </div>

    <!-- Sign Up Link -->
    <div class="text-center mt-6">
      <p class="text-gray-500 dark:text-gray-500">
        Hesabın yok mu?
        <%= link_to "Kayıt Ol", new_registration_path(resource_name), class: "text-sky-400 hover:text-sky-300 font-semibold transition-colors ml-1" %>
      </p>
    </div>
  </div>
</div>
