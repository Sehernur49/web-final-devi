<!-- Comment Form Partial -->
<div id="comment_form_<%= tweet.id %>">
  <%= form_with(model: [tweet, comment], url: tweet_comments_path(tweet), class: "w-full") do |f| %>
    <div class="flex items-center gap-3">
      <%= f.text_field :content,
        placeholder: "Yanıtını yaz...",
        maxlength: 280,
        class: "flex-1 bg-transparent text-sm text-gray-900 dark:text-white placeholder-gray-600 border-none focus:outline-none focus:ring-0 py-2",
        autocomplete: "off" %>

      <%= f.submit "Yanıtla",
        class: "bg-sky-500 text-gray-900 dark:text-white font-bold py-1.5 px-4 rounded-full text-sm hover:bg-sky-400 transition-all duration-200 cursor-pointer disabled:opacity-50 hover:scale-[1.02] active:scale-[0.98]" %>
    </div>

    <% if comment.errors.any? %>
      <div class="mt-1 text-red-400 text-xs">
        <% comment.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
